{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cli-test-mcp/schemas/case/1.0",
  "title": "CLI test case v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "batches"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"$ref": "#/$defs/id"},
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "source", "destination"],
        "properties": {
          "type": {"const": "copy"},
          "source": {"$ref": "#/$defs/path"},
          "destination": {"$ref": "#/$defs/path"}
        }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "target": {"$ref": "#/$defs/id"},
          "args": {"type": "array", "items": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "continue_on_failure": {"type": "boolean"},
          "environment": {
            "type": "object",
            "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/path"},
          "capture_after": {"enum": ["each_batch", "attempt"]},
          "reset": {"enum": ["none", "truncate", "delete"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "batch", "equals"],
            "properties": {
              "type": {"const": "exit_code"},
              "batch": {"$ref": "#/$defs/id"},
              "equals": {"type": "integer"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": {"const": "file_exists"},
              "path": {"$ref": "#/$defs/path"}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "path": {"type": "string", "minLength": 1}
  }
}
