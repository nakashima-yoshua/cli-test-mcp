{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cli-test-mcp/schemas/suite/1.0",
  "title": "CLI test suite v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"$ref": "#/$defs/id"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "sequential"},
        "stop_on_failure": {"type": "boolean"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definition"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "definition": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}
  }
}
